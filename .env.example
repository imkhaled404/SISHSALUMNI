ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
PORT=3000

# Production GitHub image uploads.
# Create a fine-grained GitHub token with Contents read/write permission
# for imkhaled404/SISHSALUMNI, then set it in Render/local .env.
GITHUB_UPLOAD_TOKEN=replace-with-github-token
GITHUB_UPLOAD_REPO=imkhaled404/SISHSALUMNI
GITHUB_UPLOAD_BRANCH=master
GITHUB_UPLOAD_DIR=public/assets/uploads
REQUIRE_PERSISTENT_UPLOADS=true

